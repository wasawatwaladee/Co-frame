    generator client {
    provider = "prisma-client-js"
    output   = "../src/generated/prisma"
  }

  datasource db {
    provider = "mysql"
     url      = env("DATABASE_URL")
  }
  enum Role {
    ADMIN
    USER
  }
  model User {
    id        Int      @id @default(autoincrement())
    username  String   @unique
    firstName String
    lastName  String
    email     String?  @unique
    mobile    String?
    password  String
    picture   String?
    role      Role     @default(USER)
    enabled   Boolean  @default(true)
    address   String?
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt @default(now())
    googleId  String?

    //Watch Party Relations
    roomsCreated   Room[]          @relation("RoomCreator")
    roomParticipants RoomParticipant[]
    chatMessages   ChatMessage[]
    votes          Vote[]

    //Community
    posts   Post[]
    comments  Comment[]
    postLikes  PostLike []
    commentLikes  CommentLike[]
  }

  //MOVIES + CATEGORY
  model Movie {
    id        Int      @id @default(autoincrement())
    title     String
    description String?
    thumbnail String?
    videoUrl  String
    poster    String
    duration  Int?     // วินาที
    createdAt DateTime @default(now())

    categories MovieCategory[]
    rooms     Room[]
  }

  model MovieCategory{
    id  Int @id @default(autoincrement())
    name String
    description String?
    createdAt DateTime @default(now())
    movieId Int

    movie Movie @relation(fields: [movieId], references: [id])
  }

  //ROOM (WATCH PARTY / LIVE WATCH)
  model Room {
    id          Int       @id @default(autoincrement())
    roomCode    String     @unique
    createdById Int
    movieId     Int
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt @default(now())
    
    //Private Mode
    isPrivate  Boolean @default(false) //if true private mode on
    passwordHash String?

    creator     User      @relation("RoomCreator", fields: [createdById], references: [id])
    movie       Movie     @relation(fields: [movieId], references: [id])

    participants RoomParticipant[]
    messages    ChatMessage[]
    votes       Vote[]
    playback    PlaybackState?
  }

  model RoomParticipant {
    id      Int   @id @default(autoincrement())
    roomId  Int
    userId  Int
    joinedAt DateTime @default(now())

    room    Room @relation(fields: [roomId], references: [id])
    user    User @relation(fields: [userId], references: [id])

    @@unique([roomId, userId])
  }

  model ChatMessage {
    id        Int     @id @default(autoincrement())
    roomId    Int
    userId    Int
    message   String
    createdAt DateTime @default(now())

    room      Room @relation(fields: [roomId], references: [id])
    user      User @relation(fields: [userId], references: [id])
  }

  model Vote {
    id       Int     @id @default(autoincrement())
    roomId   Int
    userId   Int
    type     String  // "pause" | "play" | "seek" | "rate" | "kick"
    value Int? // ไว้ใส่ตัวเลขพวกseek = กรอหนังไป-กลับ  ให้คะแนนrate หนัง kick user
    createdAt DateTime @default(now())

    room     Room @relation(fields: [roomId], references: [id])
    user     User @relation(fields: [userId], references: [id])

    @@unique([roomId, userId]) // คนหนึ่งโหวต 1 ครั้ง
  }

  model PlaybackState {
    id        Int     @id @default(autoincrement())
    roomId    Int     @unique
    isPlaying Boolean @default(true)
    currentTime Int   @default(0) // วินาที
    updatedAt DateTime @updatedAt @default(now())

    room      Room @relation(fields: [roomId], references: [id])
  }

  //Community Module (POST / COMMENT / LIKE)

model CommunityCategory{
  id Int @id @default(autoincrement())
  name String
  description String?
  createdAt DateTime @default(now())
  slug String @unique

  posts Post []
}

model Post {
  id Int @id @default(autoincrement())
  categoryId Int
  userId Int
  title String
  content String
  thumbnail String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category CommunityCategory @relation(fields: [categoryId], references: [id])
  user User @relation(fields: [userId], references: [id])

  comments Comment[]
  likes PostLike[]
}

model PostLike {
  id Int @id @default(autoincrement())
  postId Int
  userId Int
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([postId, userId])
}

model Comment {
  id Int @id @default(autoincrement())
  postId Int
  userId Int
  content String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post Post @relation(fields: [postId], references: [id])
  user User @relation(fields: [userId], references: [id])

  likes CommentLike[]
}

model CommentLike {
  id Int @id @default(autoincrement())
  commentId Int
  userId Int
  createdAt DateTime @default(now())

  comment Comment @relation(fields: [commentId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([commentId, userId])
}